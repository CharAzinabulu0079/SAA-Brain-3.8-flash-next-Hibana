@@ -24,6 +24,27 @@ from hibana.model.norm import GemmaRMSNorm
 PREFIX = "mtp"
 
 
+class _MtpWeightOverlay:
+    """Read mtp.* tensors from a standalone safetensors file while delegating other keys."""
+
+    def __init__(self, base, path: str):
+        from pathlib import Path
+        from safetensors import safe_open
+        p = Path(path)
+        self.snap = p.parent
+        self._base = base
+        self._handle = safe_open(str(p), framework="pt", device="cpu")
+        self._local = set(self._handle.keys())
+        self._map = dict(getattr(base, "_map", {}))
+        for k in self._local:
+            self._map[k] = p.name
+
+    def get(self, name: str) -> torch.Tensor:
+        if name in self._local:
+            return self._handle.get_tensor(name).clone()
+        return self._base.get(name)
+
+
 class FlashNextMtpHead(MtpLayer):
     DRAFT_HEADS = True  # set_draft_head: reduced vocabulary and/or 3-bit shortlist
 
